{
  "name": "seonghyeon-finance",
  "productName": "성현교회 재정",
  "version": "0.2.8",
  "description": "성현교회 주일 헌금 현황 및 연간 예결산",
  "main": "main.js",
  "author": "성현교회 재정부",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.seonghyeon.finance",
    "productName": "성현교회 재정",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "성현교회 재정",
      "artifactName": "SeonghyeonFinance-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
